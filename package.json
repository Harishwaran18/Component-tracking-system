{
  "name": "component-tracking-system",
  "version": "1.0.0",
  "description": "Industry-grade ECE component tracking system with JWT auth, QR tracking, inventory, issues/returns and audit logs.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "seed:demo": "node src/db/seed.js --demo",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "lint": "node --check src/server.js"
  },
  "keywords": [
    "inventory",
    "component-tracking",
    "ece",
    "qr",
    "express",
    "sqlite",
    "jwt"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/setup.js"],
    "testMatch": ["<rootDir>/tests/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js", "!src/openapi.js"],
    "coverageDirectory": "coverage"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
